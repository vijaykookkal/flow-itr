{
  "title": "ITR-3 Schedules FSI, TR and FA - data",
  "description": "Three schedules of the return, each transcribed into the shape the form prints. FSI is income earned outside India and the relief claimed on it; TR summarises that relief by country; FA is a disclosure of foreign assets held during the CALENDAR year, which is a different period from the rest of the return and must not be adjusted to the previous year.",
  "type": "object",
  "required": [
    "schedule_fsi",
    "schedule_tr",
    "schedule_fa"
  ],
  "additionalProperties": false,
  "properties": {
    "calendar_year": {
      "type": [
        "string",
        "null"
      ],
      "description": "The calendar year Schedule FA covers, e.g. '2025'. For the previous year 2025-26 this is calendar 2025, ending 31 December 2025."
    },
    "schedule_fsi": {
      "type": "array",
      "description": "Schedule FSI, one entry per country. Only a resident may claim here. Each country carries a row for every head of income, in the form's order, including the heads that are nil - the form prints all five.",
      "items": {
        "type": "object",
        "required": [
          "country_code",
          "country",
          "heads"
        ],
        "additionalProperties": false,
        "properties": {
          "country_code": {
            "type": "string",
            "description": "Column (a). The ITR country code as printed, e.g. '2' for the United States of America."
          },
          "country": {
            "type": "string",
            "description": "The country name as printed."
          },
          "taxpayer_identification_number": {
            "type": [
              "string",
              "null"
            ],
            "description": "Column (b). The taxpayer's identification number in that country."
          },
          "heads": {
            "type": "array",
            "description": "One row per head of income: i Salary, ii House Property, iii Business or Profession, iv Capital Gains, v Other Sources. Report all five even where nil, because the form prints all five and a missing row cannot be told from a nil one.",
            "items": {
              "type": "object",
              "required": [
                "item",
                "head",
                "income_outside_india"
              ],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "string",
                  "description": "The roman numeral as printed: 'i' to 'v'."
                },
                "head": {
                  "type": "string",
                  "description": "'Salary', 'House Property', 'Business or Profession', 'Capital Gains' or 'Other Sources'."
                },
                "income_outside_india": {
                  "$ref": "#/$defs/money",
                  "description": "Column (c). Income from outside India, and it must be the figure already included in Part B-TI - not the gross before Indian tax treatment."
                },
                "tax_paid_outside_india": {
                  "$ref": "#/$defs/money",
                  "description": "Column (d). Tax actually paid or withheld abroad, as the foreign document states it. A Form 1042-S is the evidence for US withholding."
                },
                "tax_payable_in_india": {
                  "$ref": "#/$defs/money",
                  "description": "Column (e). Tax payable on that income under the normal provisions in India. This is computed, so leave it out unless the document states it."
                },
                "relief_available": {
                  "$ref": "#/$defs/money",
                  "description": "Column (f). The lower of (d) and (e). Leave it out unless the document states it; the lower-of rule is arithmetic and is applied in code."
                },
                "dtaa_article": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The relevant article of the DTAA where relief is claimed under section 90 or 90A, as printed - '10' for dividends under the India-US treaty."
                }
              }
            }
          }
        }
      }
    },
    "schedule_tr": {
      "type": "object",
      "description": "Schedule TR, the summary of relief claimed for taxes paid outside India.",
      "additionalProperties": false,
      "properties": {
        "countries": {
          "type": "array",
          "description": "Item 1, one row per country.",
          "items": {
            "type": "object",
            "required": [
              "country_code",
              "country"
            ],
            "additionalProperties": false,
            "properties": {
              "country_code": {
                "type": "string",
                "description": "Column (a)."
              },
              "country": {
                "type": "string"
              },
              "taxpayer_identification_number": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Column (b)."
              },
              "total_taxes_paid_outside": {
                "$ref": "#/$defs/money",
                "description": "Column (c). The total of column (d) of Schedule FSI for that country."
              },
              "total_relief_available": {
                "$ref": "#/$defs/money",
                "description": "Column (d). The total of column (f) of Schedule FSI for that country."
              },
              "relief_section": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Column (e). '90', '90A' or '91'. Section 90 or 90A where a treaty applies, 91 where it does not."
              }
            }
          }
        },
        "tax_refunded_by_foreign_authority": {
          "$ref": "#/$defs/money",
          "description": "Item 4a. Tax paid outside India, on which relief was allowed in India, that the foreign authority has since refunded or credited. Usually nil, and it is a question the form asks explicitly."
        },
        "refund_relates_to_ay": {
          "type": [
            "string",
            "null"
          ],
          "description": "Item 4b. The assessment year in which that relief was allowed in India."
        }
      }
    },
    "schedule_fa": {
      "type": "object",
      "description": "Schedule FA. A disclosure of foreign assets held at any time during the CALENDAR year, not the previous year. Omitting an asset carries penalties under the Black Money Act, so an asset in doubt is reported, not left out.",
      "additionalProperties": false,
      "properties": {
        "a1_depository_accounts": {
          "type": "array",
          "description": "A1. Foreign depository accounts - a bank account held abroad.",
          "items": {
            "type": "object",
            "required": [
              "country_code",
              "country",
              "institution_name"
            ],
            "additionalProperties": false,
            "properties": {
              "country_code": {
                "type": "string",
                "description": "Columns (2) and (3)."
              },
              "country": {
                "type": "string"
              },
              "institution_name": {
                "type": "string",
                "description": "Column (4). Name of the financial institution."
              },
              "institution_address": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Column (5)."
              },
              "zip_code": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Column (6)."
              },
              "account_number": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Column (7)."
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Column (8), e.g. 'Beneficial owner', 'Owner', 'Beneficiary'."
              },
              "opened_on": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Column (9). ISO date the account was opened."
              },
              "peak_value": {
                "$ref": "#/$defs/money",
                "description": "Column (10). Peak balance during the period, in rupees."
              },
              "closing_value": {
                "$ref": "#/$defs/money",
                "description": "Column (11). Closing balance, in rupees."
              },
              "gross_credited": {
                "$ref": "#/$defs/money",
                "description": "Column (12). Gross interest, dividend or other amount paid or credited to the account during the period."
              },
              "nature_of_amount": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Column (12a) on A2: what the amount credited was - 'Dividend', 'Interest'."
              },
              "valuations": {
                "type": "array",
                "description": "The account's total value on each date a document states it within the calendar year -- every statement date, and 31 December in particular. In the document's own currency. The peak and closing balances are worked out from these in code, each at the rate for its own date, so give every one you can find rather than choosing.",
                "items": {
                  "type": "object",
                  "required": [
                    "on",
                    "amount"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "on": {
                      "type": "string",
                      "description": "ISO date of this figure."
                    },
                    "amount": {
                      "$ref": "#/$defs/money",
                      "description": "Total account value on that date, shares and cash together."
                    }
                  }
                }
              },
              "credits": {
                "type": "array",
                "description": "Each amount paid or credited to the account in the calendar year, gross, with its own date: dividends, interest, sale proceeds.",
                "items": {
                  "type": "object",
                  "required": [
                    "on",
                    "amount"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "on": {
                      "type": "string",
                      "description": "ISO date of this figure."
                    },
                    "amount": {
                      "$ref": "#/$defs/money",
                      "description": "The gross amount credited, before any tax withheld."
                    },
                    "nature": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "'Dividend', 'Interest', 'Sale proceeds' or 'Other income'."
                    }
                  }
                }
              }
            }
          }
        },
