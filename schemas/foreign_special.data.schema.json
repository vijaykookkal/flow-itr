                  "type": "object",
                  "required": [
                    "on",
                    "amount"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "on": {
                      "type": "string",
                      "description": "ISO date of this figure."
                    },
                    "amount": {
                      "$ref": "#/$defs/money",
                      "description": "Value of the whole holding in this entity on that date."
                    }
                  }
                }
              },
              "credits": {
                "type": "array",
                "description": "Each dividend or interest payment on this holding in the calendar year, gross.",
                "items": {
                  "type": "object",
                  "required": [
                    "on",
                    "amount"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "on": {
                      "type": "string",
                      "description": "ISO date of this figure."
                    },
                    "amount": {
                      "$ref": "#/$defs/money",
                      "description": "The gross amount, before tax withheld."
                    }
                  }
                }
              },
              "sales": {
                "type": "array",
                "description": "Each sale or redemption of this holding in the calendar year.",
                "items": {
                  "type": "object",
                  "required": [
                    "on",
                    "amount"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "on": {
                      "type": "string",
