        "a3_equity_and_debt": {
          "type": "array",
          "description": "A3. Foreign equity and debt interest held in any entity. One row per holding, so vested RSUs in an employer's stock are a row of their own.",
          "items": {
            "type": "object",
            "required": [
              "country_code",
              "country",
              "entity_name"
            ],
            "additionalProperties": false,
            "properties": {
