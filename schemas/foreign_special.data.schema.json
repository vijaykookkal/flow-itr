              },
              "nature_of_entity": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Column (7), e.g. 'Company'."
              },
              "acquired_on": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Column (8). ISO date the interest was acquired. For RSUs this is the vest date."
              },
              "initial_value": {
                "$ref": "#/$defs/money",
                "description": "Column (9). Initial value of the investment, in rupees."
              },
              "peak_value": {
                "$ref": "#/$defs/money",
                "description": "Column (10). Peak balance during the period, in rupees."
              },
              "closing_value": {
                "$ref": "#/$defs/money",
                "description": "Column (11). Closing balance, in rupees."
              },
              "gross_amount_credited": {
                "$ref": "#/$defs/money",
                "description": "Column (12). Total gross amount paid or credited with respect to the holding during the period - dividends, gross of withholding."
              },
              "gross_proceeds_on_sale": {
                "$ref": "#/$defs/money",
                "description": "Column (13). Total gross proceeds from sale or redemption during the period."
              },
              "acquisitions": {
                "type": "array",
                "description": "Every lot that makes up this holding and was held at any time in the calendar year: the date it was acquired (the vest date for an RSU), the number of shares, and its cost in the document's currency. The row's initial value is the total of these, each converted at its own date.",
                "items": {
                  "type": "object",
                  "required": [
                    "on",
                    "amount"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "on": {
                      "type": "string",
                      "description": "ISO date of this figure."
                    },
                    "amount": {
                      "$ref": "#/$defs/money",
                      "description": "Cost of the lot: for an RSU, the market value of the shares on the vest date."
                    },
                    "quantity": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Number of shares or units in the lot."
                    }
                  }
                }
              },
              "valuations": {
                "type": "array",
                "description": "The value of this holding on each date a document states it within the calendar year, 31 December in particular. Nil on a date after it was all sold.",
